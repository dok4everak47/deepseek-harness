# deepseek-harness — direnv layout
#
# Loads the Nix flake dev shell and layers a few project-specific bits on top
# so tools outside `nix develop` (editors, LSPs, git hooks) see the same env.

# Reload when the flake or its lockfile change, but not on every git status
# fluctuation inside node_modules / .pnpm-store.
watch_file flake.nix
watch_file flake.lock

# nix-direnv ships the `use flake` function. It falls back to a warning if the
# host is missing nix or the nix-direnv extension.
if ! has nix_direnv_version || ! nix_direnv_version 3.0.0 2>/dev/null; then
  echo "warning: nix-direnv >=3.0.0 is recommended; install it via 'nix profile install nixpkgs#nix-direnv' or your package manager." >&2
fi

use flake . --no-pure-eval

# --- Project-local paths that should exist outside the nix shell too. ---
PATH_add .direnv/bin

# Keep pnpm's content-addressable store inside the repo (matches flake.nix).
export PNPM_HOME="$PWD/.pnpm-home"
export PNPM_STORE_DIR="$PWD/.pnpm-store"
PATH_add "$PNPM_HOME"

# uv / python sdk venv (python/development.md convention).
export UV_PROJECT_ENVIRONMENT="$PWD/tmp/py-sdk-venv"

# Opt out of corepack auto-pinning; the flake owns the pnpm version.
export COREPACK_ENABLE_AUTO_PIN=0

# Load a repo-local .env if present (never committed).
if [ -f .env ]; then
  dotenv
fi
